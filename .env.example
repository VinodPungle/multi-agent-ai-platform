# =============================================================================
# Enterprise Multi-Agent AI Platform — example environment file
# =============================================================================
#
# Copy this file to `.env` and adjust values for your machine:
#
#   cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed.
#
# Configuration precedence (architecture.md §71), highest wins:
#
#   Environment Variables  ->  Azure Key Vault  ->  Environment YAML  ->  Defaults
#
# Every value below maps to a field on a strongly typed settings model in
# `agent_platform.configuration.settings`. Nested sections use the `__`
# delimiter, e.g. `PLATFORM_SERVER__PORT` maps to `settings.server.port`.
#
# Configuration is validated once at startup. Invalid values prevent the
# application from starting (fail fast) rather than failing at request time.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Deployment environment. One of: development | testing | staging | production
PLATFORM_APP__ENVIRONMENT=development

# Human-readable platform name, surfaced in telemetry and the OpenAPI document.
PLATFORM_APP__NAME=multi-agent-ai-platform

# Enables verbose error detail and API docs. MUST be false outside development;
# configuration validation rejects `debug=true` when environment=production.
PLATFORM_APP__DEBUG=true


# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
PLATFORM_SERVER__HOST=0.0.0.0
PLATFORM_SERVER__PORT=8000

# Comma-separated list of origins allowed to call the API from a browser.
# Use explicit origins — `*` is rejected when environment=production.
PLATFORM_SERVER__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base path prefix for all versioned routes.
PLATFORM_SERVER__API_PREFIX=/api

# Seconds to wait for in-flight requests to drain on shutdown.
PLATFORM_SERVER__GRACEFUL_SHUTDOWN_SECONDS=15


# -----------------------------------------------------------------------------
# Logging (structlog)
# -----------------------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
PLATFORM_LOGGING__LEVEL=DEBUG

# `console` renders human-readable colourised logs for local development.
# `json` emits machine-parsable records and is required outside development.
PLATFORM_LOGGING__RENDERER=console

# Adds module/function/line to every record. Useful locally, costly in volume.
PLATFORM_LOGGING__INCLUDE_SOURCE=true


# -----------------------------------------------------------------------------
# Telemetry (OpenTelemetry)
# -----------------------------------------------------------------------------
PLATFORM_TELEMETRY__ENABLED=true

# Logical service name reported to tracing backends.
PLATFORM_TELEMETRY__SERVICE_NAME=agent-platform-backend

# OTLP/HTTP collector endpoint. Leave empty to skip the OTLP exporter.
# Local collector example: http://localhost:4318
PLATFORM_TELEMETRY__OTLP_ENDPOINT=

# Prints spans to stdout. Handy locally; leave false in deployed environments.
PLATFORM_TELEMETRY__CONSOLE_EXPORTER=false

# Head-based sampling ratio in the range 0.0–1.0.
PLATFORM_TELEMETRY__SAMPLE_RATIO=1.0

# Azure Monitor / Application Insights connection string.
# Leave empty locally. In Azure this is injected from Key Vault — never commit it.
PLATFORM_TELEMETRY__AZURE_MONITOR_CONNECTION_STRING=


# -----------------------------------------------------------------------------
# LLM Gateway
# -----------------------------------------------------------------------------
# Policy applied to every model call, whichever provider serves it. Commented
# out because every value has a documented default; uncomment to override.
#
# Provider used when a request does not pin one. Optional while a single
# provider is registered, required once there is more than one.
# PLATFORM_LLM_GATEWAY__DEFAULT_PROVIDER_ID=azure-foundry
#
# Retry policy for non-streaming calls. Streaming is never retried: a partially
# delivered answer cannot be replayed.
# PLATFORM_LLM_GATEWAY__RETRY__MAX_ATTEMPTS=3
# PLATFORM_LLM_GATEWAY__RETRY__INITIAL_BACKOFF_SECONDS=0.5
# PLATFORM_LLM_GATEWAY__RETRY__BACKOFF_MULTIPLIER=2.0
# PLATFORM_LLM_GATEWAY__RETRY__MAX_BACKOFF_SECONDS=30
# PLATFORM_LLM_GATEWAY__RETRY__JITTER=true
#
# Per-hop wall-clock budgets, in seconds.
# PLATFORM_LLM_GATEWAY__TIMEOUT__MODEL_CALL_SECONDS=60
# PLATFORM_LLM_GATEWAY__TIMEOUT__FIRST_TOKEN_SECONDS=30
# PLATFORM_LLM_GATEWAY__TIMEOUT__REQUEST_SECONDS=120
# PLATFORM_LLM_GATEWAY__TIMEOUT__TOOL_CALL_SECONDS=30


# -----------------------------------------------------------------------------
# Azure AI Foundry
# -----------------------------------------------------------------------------
# There is no API key setting here, and none is accepted. Authentication is
# DefaultAzureCredential: `az login` locally, Managed Identity in Azure. The
# application code is identical in both — that is the point.
#
# Setup, RBAC and troubleshooting: docs/runbooks/azure-ai-foundry-setup.md
#
# Off by default so a clone with no Azure access starts cleanly.
PLATFORM_AZURE_FOUNDRY__ENABLED=false

# Inference endpoint from the Foundry portal. A resource identifier, not a
# secret. Enabling the provider without it stops startup.
# PLATFORM_AZURE_FOUNDRY__ENDPOINT=https://<resource>.services.ai.azure.com/models

# The DEPLOYMENT name, exactly as it appears in the portal — case included.
# Frequently not the model name, which is the single most common cause of a 404
# against a deployment you can plainly see.
# PLATFORM_AZURE_FOUNDRY__DEPLOYMENT=FW-Kimi-K3

# Platform-wide id this deployment serves. Required when the provider is
# enabled, and deliberately without a default: a model name baked into source is
# exactly what this platform forbids, and a stale one silently mislabels every
# telemetry record and cost row.
# PLATFORM_AZURE_FOUNDRY__MODEL_ID=fw-kimi-k3
# PLATFORM_AZURE_FOUNDRY__PROVIDER_ID=azure-foundry

# Advertised model limits, published through the model registry.
# PLATFORM_AZURE_FOUNDRY__MAX_CONTEXT_TOKENS=128000
# PLATFORM_AZURE_FOUNDRY__MAX_OUTPUT_TOKENS=4096

# Whether the deployed model can call tools. A model property, not a provider
# one: claiming it for a model that ignores tool definitions routes tool work
# into silence.
# PLATFORM_AZURE_FOUNDRY__SUPPORTS_TOOLS=true

# Which parameter caps generated tokens. Reasoning models reject `max_tokens`
# with an HTTP 400 and require `max_completion_tokens`. Found by a live call —
# every mock accepted `max_tokens` happily.
# PLATFORM_AZURE_FOUNDRY__OUTPUT_TOKEN_PARAMETER=max_tokens

# Published rates, used to estimate cost — the inference API does not report
# spend. Default zero, so an unconfigured deployment reports zero rather than a
# fabricated number that would reach a dashboard looking real.
# PLATFORM_AZURE_FOUNDRY__INPUT_COST_PER_MILLION_TOKENS=0.15
# PLATFORM_AZURE_FOUNDRY__OUTPUT_COST_PER_MILLION_TOKENS=0.60

# Budget for the first request to a Managed Compute deployment that has scaled
# to zero. Generous on purpose: an instance start takes tens of seconds, and a
# tight timeout makes every cold start look like an outage.
# PLATFORM_AZURE_FOUNDRY__COLD_START_TIMEOUT_SECONDS=120


# -----------------------------------------------------------------------------
# Multi-agent collaboration
# -----------------------------------------------------------------------------
# A research specialist the chat agent can delegate to. No new class was needed:
# an agent's behaviour lives in its descriptor and prompt, so a specialist is
# configuration plus a prompt asset.
#
# Off by default. A second agent doubles the model calls one request can make,
# and that should be a decision rather than a default.
PLATFORM_RESEARCH_AGENT__ENABLED=false

# Empty inherits the chat agent's provider and model. Setting them is how one
# agent uses a cheaper or stronger model than another.
# PLATFORM_RESEARCH_AGENT__PROVIDER_ID=
# PLATFORM_RESEARCH_AGENT__MODEL_ID=

# Lower than the chat agent's: research answers summarise found evidence, and
# creativity there is indistinguishable from invention.
# PLATFORM_RESEARCH_AGENT__TEMPERATURE=0.1

# The specialist searches; it cannot delegate. There is nobody below it.
# PLATFORM_RESEARCH_AGENT__TOOL_IDS=internet-search

# How many agents deep one user request may go. Two lets a coordinator consult
# a specialist. Raising it multiplies the worst-case cost of a single request,
# and a cycle costs that much before anything stops it.
# PLATFORM_RESEARCH_AGENT__MAX_DELEGATION_DEPTH=2


# -----------------------------------------------------------------------------
# Mock provider (development and testing only)
# -----------------------------------------------------------------------------
# Answers locally instead of calling a model, so the chat experience works with
# no Azure access and costs nothing to run. Turn it off once Azure AI Foundry is
# configured above and pointed at by PLATFORM_AGENT__PROVIDER_ID.
#
# Configuration validation REJECTS this in staging and production: a deployment
# serving templated answers would look like a working system.
PLATFORM_MOCK_PROVIDER__ENABLED=true

# Pause between streamed chunks, in seconds. Raise it to see the streaming UI
# more slowly; 0 disables the delay entirely.
PLATFORM_MOCK_PROVIDER__CHUNK_DELAY_SECONDS=0.02


# -----------------------------------------------------------------------------
# Chat and the agent that answers it
# -----------------------------------------------------------------------------
# Agent that answers chat turns. Pointing chat at a different agent is a
# configuration change.
PLATFORM_CHAT__AGENT_ID=chat-agent

# Longest single message accepted, in characters.
PLATFORM_CHAT__MAX_PROMPT_CHARACTERS=32000

# Where the versioned prompt assets live, relative to the working directory.
PLATFORM_CHAT__PROMPTS_DIRECTORY=prompts

# The agent's model and provider, resolved through the registries. Must be one a
# registered provider serves — startup refuses an agent naming a model nothing
# can answer with.
PLATFORM_AGENT__PROVIDER_ID=mock
PLATFORM_AGENT__MODEL_ID=mock-echo

# Prompt asset the agent uses. Pin a version for reproducible behaviour across a
# prompt change; leave unset to take the newest.
PLATFORM_AGENT__PROMPT_ID=chat-agent-system
# PLATFORM_AGENT__PROMPT_VERSION=1.0


# -----------------------------------------------------------------------------
# Conversation memory
# -----------------------------------------------------------------------------
# In-process and bounded. Conversations are lost on restart and are NOT shared
# between replicas — this provider must not run behind a load balancer.
PLATFORM_MEMORY__MAX_CONVERSATIONS=500
PLATFORM_MEMORY__MAX_MESSAGES_PER_CONVERSATION=200


# -----------------------------------------------------------------------------
# Internet search
# -----------------------------------------------------------------------------
# Which backend answers the internet-search tool. This is a platform-wide
# choice: agents declare the *tool*, not a backend, so changing it changes what
# every agent searches with.
#
#   duckduckgo  real search, no API key required   (default)
#   tavily      ranked web results, needs a key    (best quality)
#   mock        fabricated results, no network     (CI and offline work)
#
# The DuckDuckGo Instant Answer API returns abstracts and related topics, not
# ranked web results: strong on encyclopaedic questions, weak on current
# events. Tavily is built for retrieval augmentation and handles both, at a
# per-search cost.
PLATFORM_SEARCH__PROVIDER=duckduckgo

# Tavily API key — required only when PROVIDER=tavily. Get one at
# https://tavily.com; keys begin with "tvly-". Startup fails if Tavily is
# selected without it, rather than failing the first search with a 401.
#
# This is a real secret. It belongs in .env (git-ignored) locally and in Key
# Vault in Azure — never in .env.example, a Docker image or a commit.
# PLATFORM_SEARCH__TAVILY_API_KEY=

# Tavily search depth: basic or advanced. `advanced` returns better evidence
# and costs more per search, so it is a deployment decision.
# PLATFORM_SEARCH__SEARCH_DEPTH=basic

# Whole-request budget for one search, in seconds.
PLATFORM_SEARCH__TIMEOUT_SECONDS=10

# Results per search. Every result is spent context in the next prompt, so
# this is a cost setting as much as a quality one.
PLATFORM_SEARCH__MAX_RESULTS=5


# -----------------------------------------------------------------------------
# Agent tools and budgets
# -----------------------------------------------------------------------------
# Tools the chat agent may call. A tool this deployment has not registered is
# skipped with a warning rather than failing the agent.
PLATFORM_AGENT__TOOL_IDS=internet-search

# Bounds on one turn's tool loop. Enforced between iterations, where stopping
# still saves the next call — an unbounded loop turns one request into an
# open-ended bill.
PLATFORM_AGENT__MAX_TOOL_INVOCATIONS=4
PLATFORM_AGENT__MAX_MODEL_CALLS=4


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Milestone 01 registers no providers, agents or tools. These flags exist so
# later milestones can be enabled by configuration alone, never by code change.
PLATFORM_FEATURES__STREAMING=false
# A real off switch: with it false the tool is not registered at all, so an
# agent that declares it simply runs without it and a turn costs one model call.
PLATFORM_FEATURES__SEARCH=true
PLATFORM_FEATURES__MEMORY=false
PLATFORM_FEATURES__EVALUATION=false
PLATFORM_FEATURES__COST_TRACKING=false


# -----------------------------------------------------------------------------
# Docker Compose host ports
# -----------------------------------------------------------------------------
# Only the host side of each mapping. Change these when 8000 or 5173 is already
# taken on your machine; the container-side ports never change, so nothing else
# needs adjusting.
BACKEND_PORT=18000
FRONTEND_PORT=5173


# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# Only variables prefixed with `VITE_` are exposed to browser code.
# NEVER place a secret behind a VITE_ prefix — it is embedded in the bundle.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Multi-Agent AI Platform


# =============================================================================
# Not used in Milestone 01 — listed so the surface is known in advance.
# Azure resources are reached with DefaultAzureCredential (`az login` locally,
# Managed Identity in Azure). No API keys are introduced for Azure AI Foundry.
# =============================================================================
# PLATFORM_PROVIDERS__AZURE_FOUNDRY__ENDPOINT=
# PLATFORM_PROVIDERS__AZURE_FOUNDRY__DEPLOYMENT=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
